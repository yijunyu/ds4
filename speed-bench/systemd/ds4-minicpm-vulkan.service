[Unit]
# MiniCPM-V 4.7 35B-A3B on llama.cpp + Vulkan (RADV/gfx1151), 128K context.
# Replaces the PolyStrata backend because Vulkan measured +18% decode (68.6 vs 58.0
# tok/s) on identical weights; it costs ~10% prefill (1127 vs 1255), which is the
# trade accepted here for an interactive service. See AMD_PREFILL_TUNING.md.
#
# Binds the LAN so a trusted host can reach it; the API key is read from an
# EnvironmentFile (mode 600) and is REQUIRED off loopback.
# Only one large model may be resident: stop the PolyStrata unit and `ds4-local`
# before starting this one.
Description=DS4 local MiniCPM service, LAN-bound (llama.cpp Vulkan, API key required)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/llama-vulkan/bin
# The Vulkan loader lives in the SDK we unpacked, not in /usr (no root needed).
Environment=LD_LIBRARY_PATH=/home/yijun/llama-tile/bin:/home/yijun/vulkan-sdk/x86_64/lib:/home/yijun/vulkan-sdk/x86_64/lib/VulkanLoader/lib
# tile-rs expert matvec shaders (generated by tile-rs mlir_to_spirv); see AMD_PREFILL_TUNING.md.
# Remove these two lines to run the stock llama.cpp Vulkan kernels.
Environment=LLAMA_TILE_MMVQ4K_SPV=/home/yijun/llama-tile/shaders/moe_q4k.spv
Environment=LLAMA_TILE_MMVQ6K_SPV=/home/yijun/llama-tile/shaders/moe_q6k.spv
# --mmproj: vision enabled (MiniCPM-V-4.7 is a vision model; without it image requests fail).
# Same projector variant studio serves. Verified: two differently coloured images read correctly.
# n-gram lookup decoding: identical greedy output; about +20% decode on copy-heavy prompts, unchanged otherwise.
# -ub 1024: prefill +2% over -ub 2048 (pp2048 1180 vs 1152); changes prefill numerics slightly (KLD 0.0044).
# Decode +3% on MiniCPM-V-4.7 with identical output (measured 10 repeats; see llama_hook/sweep).
Environment=GGML_VK_ALLOW_GRAPHICS_QUEUE=1
# --slot-save-path enables POST /slots/{id}?action=save|restore, which is how
# mind-arbiter keeps this model's prompt caches across a swap to another model; without
# it the endpoint answers with an error and a swap back has to re-prefill from nothing.
# Files land in that directory named by the arbiter's registry (minicpm-v4.7-slotN.bin)
# and are overwritten on each save, so the space used is bounded by the slot count.
EnvironmentFile=%h/.local/state/ds4-local/lan-service.env
ExecStart=/home/yijun/llama-tile/bin/llama-server \
  -m /home/yijun/models/minicpm/MiniCPM-V-4_7-35B-A3B-Q4_K_M.gguf \
  --mmproj /home/yijun/models/minicpm/mmproj-model-f16-4x.gguf \
  -c 131072 -ngl 99 --host 0.0.0.0 --port 8000 -t 16 --no-webui \
  --alias minicpm-v4.7-35b-a3b-q4km --jinja \
  --reasoning-format deepseek --reasoning off \
  -fa on -b 8192 -ub 1024 --spec-type ngram-simple --spec-draft-n-max 4 \
  --slot-save-path /data/kvcache/minicpm --api-key ${DS4_LAN_API_KEY}
Restart=on-failure
RestartSec=10
# The model is 21.2 GiB resident plus the KV cache for 131072 tokens.
OOMPolicy=stop
LimitNOFILE=65535
KillMode=mixed
TimeoutStopSec=90

[Install]
WantedBy=default.target
