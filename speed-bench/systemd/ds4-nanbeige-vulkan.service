[Unit]
# Nanbeige4.3-33B on llama.cpp + Vulkan (RADV/gfx1151). A dense 33.1B released
# 2026-10-24 under Apache-2.0, aimed at agentic coding; its own benchmark claims
# (Terminal-Bench 2.1 80.9 against Qwen3.8-27B's 73.0) are unreplicated, which is
# why the registry marks it opt_in rather than making it routable by default.
#
# Plain LlamaForCausalLM, so no new llama.cpp support is involved. The quants were
# cut at b11845 and llama-tile is b11854-5, which is past it.
#
# Started and stopped by mind-arbiter, never enabled: it cannot be resident
# alongside DeepSeek V4.1, and the arbiter is what knows that.
Description=DS4 local Nanbeige4.3-33B service (llama.cpp Vulkan, API key required)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/llama-vulkan/bin
# The Vulkan loader lives in the SDK we unpacked, not in /usr (no root needed).
Environment=LD_LIBRARY_PATH=/home/yijun/llama-tile/bin:/home/yijun/vulkan-sdk/x86_64/lib:/home/yijun/vulkan-sdk/x86_64/lib/VulkanLoader/lib
Environment=GGML_VK_ALLOW_GRAPHICS_QUEUE=1
# Deliberately NOT setting LLAMA_TILE_MMVQ4K_SPV / MMVQ6K_SPV. Those tile-rs shaders
# replace the expert matvec kernels, and this model has no experts -- it is dense,
# unlike MiniCPM-V 4.7's 35B-A3B. They would do nothing here.
EnvironmentFile=%h/.local/state/ds4-local/lan-service.env
# -c 131072 rather than the advertised 524288. This model's KV is 208 KiB/token at
# f16 (52 layers x 8 KV heads x 128), about ten times MiniCPM's measured ~20 KiB, so
# the full context would want 104 GiB of KV on a 122 GiB box.
# -ctk/-ctv q8_0 halves that, and it is what makes 131072 affordable: measured 34.1
# GiB of the pool here, against 32.8 GiB for 65536 with an f16 cache. Twice the
# context for 1.3 GiB, which is the whole reason for quantizing the cache rather
# than a general preference. The cost is 2% of prefill (279 vs 285 tok/s) and some
# cache numerics; both were measured, see the sweep note below.
# Verified that quantized KV does not break persistence, which is the one thing that
# would have ruled it out: a 2927-token slot saved in 78 ms and restored into a
# *different* slot index in 24 ms, turning 9479 ms of prefill into 101 ms. Slot files
# are 113 KiB/token, so a full pair projects to ~14 GiB on --slot-save-path.
# --parallel 2 is stated rather than left to default: --parallel defaults to auto,
# which picks 4 on this box, and the slot count in the registry has to agree with
# the server or the extra slots are never saved (mind-arbiter checks this at startup
# and warns). 131072 total means 65536 per slot.
# -b 8192 -ub 1024 came from the MiniCPM tuning, and a sweep here found it makes no
# difference to this model: -ub 512/1024/2048 measured 281/285/288 tok/s of prefill,
# a 2.5% spread that is noise. Kept for consistency with the other unit, but nothing
# about these two numbers is tuned for Nanbeige -- do not read them as measured.
# Measured: prefill 285 tok/s on a 6329-token prompt, decode 9.7 tok/s. Decode is a
# sixth of MiniCPM's 68.6 because this model is dense and every token reads all
# 19.4 GiB of weights, where MiniCPM activates ~3B of its 35B.
# Beware a small prompt for prefill: 43 tokens measured 109.6 tok/s here, which is
# latency, not throughput, and is not comparable to MiniCPM's pp2048 figures.
#
# --spec-type ngram-simple is the only thing that moves decode on this model, and it
# moves it a long way: 37.6 tok/s against 10.1 on an edit-this-file prompt, 3.7x,
# with 249 of 249 drafted tokens accepted. No engine can do that -- decode here runs
# 202 GB/s of a ~256 GB/s pool, so anything reading these weights one token at a time
# is within a quarter of this number whatever its kernels look like. Drafting wins by
# verifying several tokens per pass instead of going faster. n-max 4 beat 8 (37.6 vs
# 36.5), and no draft model is involved: the n-grams come from the prompt, which is
# why it pays on agentic coding and not on prose (10.85 vs 10.14 there, so it costs
# nothing when it misses).
# It is NOT bit-reproducible, which is the price. Greedy output was byte-identical to
# non-speculative decode on the copy-heavy prompt, but diverged at byte 693 on free
# prose -- same claim, different wording. Both n-max 4 and 8 produced the *same*
# divergent text, which points at the numerics of batched verification rather than a
# drafting fault, and is the same class of effect as -ub changing prefill numerics on
# the MiniCPM unit (KLD 0.0044 there). Worth knowing before trusting that unit's
# claim of "identical greedy output" as a general property: on this model it holds
# for copied text and not for prose. Drop this flag if a run has to be reproducible.
ExecStart=/home/yijun/llama-tile/bin/llama-server \
  -m /data/gguf/Nanbeige4.3-33B-Q4_K_M.gguf \
  -c 131072 --parallel 2 -ngl 99 --host 127.0.0.1 --port 8003 -t 16 --no-webui \
  --alias nanbeige4.3-33b --jinja --reasoning-format deepseek \
  -fa on -b 8192 -ub 1024 -ctk q8_0 -ctv q8_0 \
  --spec-type ngram-simple --spec-draft-n-max 4 \
  --slot-save-path /data/kvcache/nanbeige --api-key ${DS4_LAN_API_KEY}
# Loopback only. MiniCPM binds the LAN for direct clients that predate the router;
# nothing reaches this one except mind-arbiter on the same host, so there is no
# reason to offer it a listener off-box. The key is still required.
Restart=on-failure
RestartSec=10
OOMPolicy=stop
LimitNOFILE=65535
KillMode=mixed
# Long enough for a slot save of ~14 GiB to finish before SIGKILL: the arbiter asks
# the server to save its slots before stopping it, and a truncated save is a cold
# slot on the way back.
TimeoutStopSec=120

[Install]
WantedBy=default.target
